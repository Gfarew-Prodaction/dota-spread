# Copy values into Render → Environment. Never commit real credentials.
# Empty DATABASE_URL keeps local SQLite; PostgreSQL enables shared persistent storage.
DATABASE_URL=
COLLECTOR_ROLE=all
STEAM_REQUEST_INTERVAL=4
UPDATE_INTERVAL=10
STEAM_PRIORITY_SIZE=400
# Optional SteamApis key, not an ordinary Steam Web API key. Keep it server-side.
STEAMAPIS_KEY=
STEAMAPIS_REFRESH_INTERVAL=60
# Currency used ONLY for discovery ranking; final prices always come from Steam.
STEAMAPIS_CURRENCY=USD
